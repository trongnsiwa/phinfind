124:             >
125:               <Heart size={16} className={isFav ? 'fill-rose-500 text-rose-500' : 'text-phin-800'} />
126:             </Button>
127:           </div>
128:         </div>
129:         {/* Bottom Hero Info Overlay */}
130:         <div className="absolute bottom-4 left-4 right-4 text-white space-y-1.5">
131:           <div className="flex items-center gap-2">
132:             <Badge
133:               variant="outline"
