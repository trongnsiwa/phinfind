<file path="src/hooks/useLocation.ts">
 1: 'use client';
 2: import { useEffect, useState } from 'react';
 3: import { DEFAULT_LOCATION } from '@/lib/utils/constants';
 4: export interface LocationState {
 5:   lat: number;
 6:   lng: number;
 7:   error: string | null;
 8:   loading: boolean;
 9:   isFallback: boolean;
10: }
11: export function useLocation() {
12:   const [location, setLocation] = useState<LocationState>({
13:     lat: DEFAULT_LOCATION.lat,
14:     lng: DEFAULT_LOCATION.lng,
15:     error: null,
16:     loading: true,
17:     isFallback: true,
18:   });
19:   const requestLocation = () => {
20:     if (!navigator.geolocation) {
21:       setLocation({
22:         lat: DEFAULT_LOCATION.lat,
23:         lng: DEFAULT_LOCATION.lng,
24:         error: 'Geolocation is not supported by your browser',
25:         loading: false,
26:         isFallback: true,
27:       });
28:       return;
29:     }
30:     setLocation((prev) => ({ ...prev, loading: true, error: null }));
31:     navigator.geolocation.getCurrentPosition(
32:       (position) => {
33:         setLocation({
34:           lat: position.coords.latitude,
35:           lng: position.coords.longitude,
36:           error: null,
37:           loading: false,
38:           isFallback: false,
39:         });
40:       },
41:       (error) => {
42:         console.warn('Geolocation error:', error.message);
43:         setLocation({
44:           lat: DEFAULT_LOCATION.lat,
45:           lng: DEFAULT_LOCATION.lng,
46:           error: error.message,
47:           loading: false,
48:           isFallback: true,
49:         });
50:       },
51:       {
52:         enableHighAccuracy: true,
53:         timeout: 10000,
54:         maximumAge: 60000,
55:       }
56:     );
57:   };
58:   useEffect(() => {
59:     requestLocation();
60:   }, []);
61:   return {
62:     ...location,
63:     refetchLocation: requestLocation,
64:   };
65: }
</file>

