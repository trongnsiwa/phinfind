<file path="src/components/bento/InfiniteScroll.tsx">
 1: 'use client';
 2: import React, { useEffect, useRef } from 'react';
 3: interface InfiniteScrollProps {
 4:   onLoadMore: () => void;
 5:   hasMore: boolean;
 6:   isLoading: boolean;
 7: }
 8: export function InfiniteScroll({ onLoadMore, hasMore, isLoading }: InfiniteScrollProps) {
 9:   const sentinelRef = useRef<HTMLDivElement>(null);
10:   useEffect(() => {
11:     if (!hasMore || isLoading) return;
12:     const observer = new IntersectionObserver(
13:       (entries) => {
14:         if (entries[0].isIntersecting) {
15:           onLoadMore();
16:         }
17:       },
18:       { threshold: 0.5 }
19:     );
20:     const currentSentinel = sentinelRef.current;
21:     if (currentSentinel) {
22:       observer.observe(currentSentinel);
23:     }
24:     return () => {
25:       if (currentSentinel) {
26:         observer.unobserve(currentSentinel);
27:       }
28:     };
29:   }, [hasMore, isLoading, onLoadMore]);
30:   if (!hasMore) {
31:     return (
32:       <div className="col-span-full py-8 text-center text-xs text-phin-600 font-medium">
33:         ☕ You&apos;ve explored all nearby coffee spots!
34:       </div>
35:     );
36:   }
37:   return (
38:     <div ref={sentinelRef} className="col-span-full py-6 flex items-center justify-center">
39:       {isLoading && (
40:         <div className="flex items-center gap-2 text-xs font-semibold text-phin-700">
41:           <span className="w-4 h-4 rounded-full border-2 border-primary border-t-transparent animate-spin" />
42:           Brewing more coffee spots...
43:         </div>
44:       )}
45:     </div>
46:   );
47: }
</file>

