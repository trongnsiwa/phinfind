<file path="supabase/schema.sql">
 1: -- PhinFind Supabase PostgreSQL Schema Setup
 2: -- 1. Profiles Table
 3: CREATE TABLE IF NOT EXISTS public.profiles (
 4:   id UUID REFERENCES auth.users ON DELETE CASCADE PRIMARY KEY,
 5:   username TEXT UNIQUE,
 6:   full_name TEXT,
 7:   avatar_url TEXT,
 8:   email TEXT,
 9:   created_at TIMESTAMPTZ DEFAULT NOW(),
10:   updated_at TIMESTAMPTZ DEFAULT NOW()
11: );
12: -- Index for username lookups
13: CREATE INDEX IF NOT EXISTS idx_profiles_username ON public.profiles(username);
14: -- 2. Saved Shops Table
15: CREATE TABLE IF NOT EXISTS public.saved_shops (
16:   id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
17:   user_id UUID REFERENCES public.profiles(id) ON DELETE CASCADE NOT NULL,
18:   place_id TEXT NOT NULL,
19:   name TEXT NOT NULL,
20:   address TEXT,
21:   created_at TIMESTAMPTZ DEFAULT NOW(),
22:   UNIQUE(user_id, place_id)
23: );
24: -- Index for user favorites query
25: CREATE INDEX IF NOT EXISTS idx_saved_shops_user_id ON public.saved_shops(user_id);
26: -- 3. Row Level Security (RLS) Policies
27: ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;
28: ALTER TABLE public.saved_shops ENABLE ROW LEVEL SECURITY;
29: -- Profiles: Public can read profiles, users can update their own
30: CREATE POLICY "Public profiles are viewable by everyone" ON public.profiles
31:   FOR SELECT USING (true);
32: CREATE POLICY "Users can update their own profile" ON public.profiles
33:   FOR UPDATE USING (auth.uid() = id);
34: -- Saved Shops: Users can view, insert, and delete their own saved shops
35: CREATE POLICY "Users can view own saved shops" ON public.saved_shops
36:   FOR SELECT USING (auth.uid() = user_id);
37: CREATE POLICY "Users can insert own saved shops" ON public.saved_shops
38:   FOR INSERT WITH CHECK (auth.uid() = user_id);
39: CREATE POLICY "Users can delete own saved shops" ON public.saved_shops
40:   FOR DELETE USING (auth.uid() = user_id);
41: -- 4. Automated User Profile Creation Trigger
42: CREATE OR REPLACE FUNCTION public.handle_new_user()
43: RETURNS TRIGGER AS $$
44: BEGIN
45:   INSERT INTO public.profiles (id, full_name, avatar_url, email)
46:   VALUES (
47:     NEW.id,
48:     COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.raw_user_meta_data->>'name'),
49:     NEW.raw_user_meta_data->>'avatar_url',
50:     NEW.email
51:   );
52:   RETURN NEW;
53: END;
54: $$ LANGUAGE plpgsql SECURITY DEFINER;
55: -- Trigger firing on auth.users insert
56: DROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;
57: CREATE TRIGGER on_auth_user_created
58:   AFTER INSERT ON auth.users
59:   FOR EACH ROW EXECUTE FUNCTION public.handle_new_user();
</file>

