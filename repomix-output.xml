  1: 'use client';
  2: import React, { useState } from 'react';
  3: import Link from 'next/link';
  4: import { Heart, MapPin, Navigation, Star, Footprints, ExternalLink } from 'lucide-react';
  5: import { Button } from '@/components/ui/button';
  6: import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';
  7: import { Badge } from '@/components/ui/badge';
  8: import { APP_ROUTES } from '@/lib/utils/constants';
  9: import { CoffeeShop } from '@/types/shop';
 10: import { cn } from '@/lib/utils';
 11: interface ShopCardProps {
 12:   shop: CoffeeShop;
 13:   isFavorite?: boolean;
 14:   onToggleFavorite?: (placeId: string) => void;
 15:   onSelect?: (shop: CoffeeShop) => void;
 16: }
 17: export function ShopCard({
 18:   shop,
 19:   isFavorite = false,
 20:   onToggleFavorite,
 21:   onSelect,
 22: }: ShopCardProps) {
 23:   const isOpen = shop.opening_hours?.open_now ?? true;
 24:   const [isHeartAnimating, setIsHeartAnimating] = useState(false);
 25:   const handleFavoriteClick = (e: React.MouseEvent) => {
 26:     e.stopPropagation();
 27:     e.preventDefault();
 28:     setIsHeartAnimating(true);
 29:     setTimeout(() => setIsHeartAnimating(false), 300);
 30:     onToggleFavorite?.(shop.place_id);
 31:   };
 32:   const getDirectionsUrl = () => {
 33:     return `https://www.google.com/maps/dir/?api=1&destination=${shop.lat},${shop.lon}`;
 34:   };
 35:   // Sample decorative coffee shop cover images based on shop ID hash
 36:   const sampleImages = [
 37:     'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=600&q=80',
 38:     'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=600&q=80',
 39:     'https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=600&q=80',
 40:     'https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=600&q=80',
 41:   ];
 42:   const charCodeSum = shop.id.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
 43:   const coverImage = shop.photos?.[0] || sampleImages[charCodeSum % sampleImages.length];
 44:   return (
 45:     <Card
 46:       className="group p-0 bg-white rounded-2xl border border-phin-100 shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 cursor-pointer overflow-hidden flex flex-col justify-between"
 47:       onClick={() => onSelect?.(shop)}
 48:     >
 49:       {/* Shop Image Header with Overlay & Floating Badges */}
 50:       <div className="relative w-full h-40 overflow-hidden bg-phin-100">
 51:         <img
 52:           src={coverImage}
 53:           alt={shop.name}
 54:           className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
 55:           loading="lazy"
 56:         />
 57:         <div className="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20" />
 58:         {/* Floating Open/Closed Status Badge */}
 59:         <div className="absolute top-3 left-3 z-10 flex items-center gap-1.5">
 60:           <Badge
 61:             variant="outline"
 62:             className={cn(
 63:               'text-[10px] font-bold px-2.5 py-0.5 rounded-full border shadow-sm backdrop-blur-md',
 64:               isOpen
 65:                 ? 'bg-emerald-500/90 text-white border-emerald-400'
 66:                 : 'bg-rose-500/90 text-white border-rose-400'
 67:             )}
 68:           >
 69:             <span className={cn('w-1.5 h-1.5 rounded-full mr-1 inline-block', isOpen ? 'bg-emerald-200 animate-pulse' : 'bg-rose-200')} />
 70:             {isOpen ? 'Open Now' : 'Closed'}
 71:           </Badge>
 72:           {shop.price_range && (
 73:             <Badge variant="secondary" className="bg-white/90 text-phin-900 font-bold text-[10px] shadow-sm backdrop-blur-md">
 74:               {shop.price_range}
 75:             </Badge>
 76:           )}
 77:         </div>
 78:         {/* Floating Heart Favorite Button */}
 79:         <Button
 80:           variant="ghost"
 81:           size="icon"
 82:           onClick={handleFavoriteClick}
 83:           aria-label={isFavorite ? 'Remove from favorites' : 'Save to favorites'}
 84:           className="absolute top-3 right-3 z-10 h-8 w-8 rounded-full bg-white/90 backdrop-blur-md hover:bg-white text-phin-700 shadow-sm transition-transform active:scale-95"
 85:         >
 86:           <Heart
 87:             size={16}
 88:             className={cn(
 89:               'transition-all duration-300',
 90:               isFavorite ? 'fill-rose-500 text-rose-500' : 'text-phin-600 hover:text-rose-500',
 91:               isHeartAnimating && 'animate-heart-beat'
 92:             )}
 93:           />
 94:         </Button>
 95:         {/* Shop Name & Address on Image Overlay */}
 96:         <div className="absolute bottom-3 left-3 right-3 text-white">
 97:           <h3 className="font-sans font-bold text-base leading-tight drop-shadow-md group-hover:text-phin-100 transition-colors line-clamp-1">
 98:             {shop.name}
 99:           </h3>
100:           <p className="text-[11px] text-phin-100/90 flex items-center gap-1 mt-0.5 line-clamp-1 drop-shadow-sm">
101:             <MapPin size={12} className="text-phin-300 flex-shrink-0" />
102:             {shop.address}
103:           </p>
104:         </div>
105:       </div>
106:       {/* Card Content & Details Footer */}
107:       <CardContent className="p-3.5 space-y-3 bg-white">
108:         <div className="flex items-center justify-between text-xs pt-1 border-t border-phin-50">
109:           <div className="flex items-center gap-2">
110:             <Badge variant="outline" className="bg-amber-50 text-amber-800 border-amber-200 flex items-center gap-1 font-bold text-[11px] py-0.5 px-2">
111:               <Star size={12} className="fill-amber-400 text-amber-400" />
112:               {shop.rating.toFixed(1)}
113:               <span className="text-[10px] text-amber-600 font-normal">({shop.total_ratings})</span>
114:             </Badge>
115:             <span className="text-phin-600 font-medium text-[11px] flex items-center gap-1">
116:               <Footprints size={12} className="text-phin-500" />
117:               {shop.distance_text}
118:             </span>
119:           </div>
120:           {/* Action Buttons */}
121:           <div className="flex items-center gap-1.5">
122:             <a
123:               href={getDirectionsUrl()}
124:               target="_blank"
125:               rel="noopener noreferrer"
126:               onClick={(e) => e.stopPropagation()}
127:             >
128:               <Button variant="outline" size="sm" className="h-7 px-2.5 text-[11px] border-phin-200 text-phin-800 hover:bg-phin-100 rounded-lg">
129:                 <Navigation size={11} className="mr-1 text-primary" />
130:                 Nav
131:               </Button>
132:             </a>
133:             <Link href={APP_ROUTES.SHOP_DETAIL(shop.id)} onClick={(e) => e.stopPropagation()}>
134:               <Button variant="default" size="sm" className="h-7 px-2.5 text-[11px] bg-phin-800 text-white hover:bg-phin-900 rounded-lg font-semibold">
135:                 View
136:                 <ExternalLink size={10} className="ml-1 opacity-70" />
137:               </Button>
138:             </Link>
139:           </div>
140:         </div>
141:       </CardContent>
142:     </Card>
143:   );
144: }
</file>

