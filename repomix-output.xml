 2: import { useEffect, useState } from 'react';
 3: import { User } from '@supabase/supabase-js';
 4: import { createClient } from '@/lib/supabase/client';
 5: import { UserProfile } from '@/types/user';
 6: export function useAuth() {
 7:   const [user, setUser] = useState<User | null>(null);
 8:   const [profile, setProfile] = useState<UserProfile | null>(null);
 9:   const [loading, setLoading] = useState(true);
10:   const supabase = createClient();
11:   useEffect(() => {
12:     async function getUserSession() {
13:       try {
14:         const {
15:           data: { session },
16:         } = await supabase.auth.getSession();
17:         setUser(session?.user ?? null);
18:         if (session?.user) {
19:           const { data } = await supabase
20:             .from('profiles')
21:             .select('*')
22:             .eq('id', session.user.id)
23:             .single();
24:           setProfile(data);
25:         }
26:       } catch (error) {
27:         console.error('Error fetching session:', error);
28:       } finally {
29:         setLoading(false);
30:       }
31:     }
32:     getUserSession();
33:     const {
34:       data: { subscription },
35:     } = supabase.auth.onAuthStateChange(async (_event, session) => {
36:       setUser(session?.user ?? null);
37:       if (session?.user) {
38:         const { data } = await supabase
39:           .from('profiles')
40:           .select('*')
41:           .eq('id', session.user.id)
42:           .single();
43:         setProfile(data);
44:       } else {
45:         setProfile(null);
46:       }
47:       setLoading(false);
48:     });
49:     return () => {
50:       subscription.unsubscribe();
51:     };
52:   }, [supabase]);
53:   const signOut = async () => {
54:     await supabase.auth.signOut();
55:   };
56:   return {
57:     user,
58:     profile,
59:     loading,
60:     isAuthenticated: !!user,
61:     signOut,
62:   };
