  1: import axios from 'axios';
  2: import { CoffeeShop, GeoapifyPlacesResponse } from '@/types/shop';
  3: const GEOAPIFY_BASE_URL = 'https://api.geoapify.com/v2';
  4: const GEOAPIFY_GEOCODE_URL = 'https://api.geoapify.com/v1/geocode/search';
  5: export async function fetchNearbyCoffeeShops(
  6:   lat: number,
  7:   lon: number,
  8:   radiusMeters: number = 3000
  9: ): Promise<CoffeeShop[]> {
 10:   const apiKey = process.env.NEXT_PUBLIC_GEOAPIFY_API_KEY;
 11:   if (!apiKey) {
 12:     console.warn('Geoapify API key missing. Returning fallback sample shops.');
 13:     return getFallbackShops(lat, lon);
 14:   }
 15:   try {
 16:     const response = await axios.get<GeoapifyPlacesResponse>(
 17:       `${GEOAPIFY_BASE_URL}/places`,
 18:       {
 19:         params: {
 20:           categories: 'catering.cafe,catering.coffee_shop',
 21:           filter: `circle:${lon},${lat},${radiusMeters}`,
 22:           bias: `proximity:${lon},${lat}`,
 23:           limit: 50,
 24:           apiKey,
 25:         },
 26:       }
 27:     );
 28:     return response.data.features.map((feature, idx) =>
 29:       mapGeoapifyToCoffeeShop(feature, lat, lon, idx)
 30:     );
 31:   } catch (error) {
 32:     console.error('Error fetching nearby coffee shops from Geoapify:', error);
 33:     return getFallbackShops(lat, lon);
 34:   }
 35: }
 36: export async function fetchPlaceDetails(placeId: string): Promise<CoffeeShop | null> {
 37:   const apiKey = process.env.NEXT_PUBLIC_GEOAPIFY_API_KEY;
 38:   if (!apiKey) return null;
 39:   try {
 40:     const response = await axios.get(`${GEOAPIFY_BASE_URL}/places/${placeId}`, {
 41:       params: { apiKey },
 42:     });
 43:     const feature = response.data.features?.[0];
 44:     if (!feature) return null;
 45:     return mapGeoapifyToCoffeeShop(feature, feature.properties.lat, feature.properties.lon, 0);
 46:   } catch (error) {
 47:     console.error('Error fetching place details:', error);
 48:     return null;
 49:   }
 50: }
 51: export async function searchCoffeeShops(
 52:   text: string,
 53:   lat?: number,
 54:   lon?: number
 55: ): Promise<CoffeeShop[]> {
 56:   const apiKey = process.env.NEXT_PUBLIC_GEOAPIFY_API_KEY;
 57:   if (!apiKey) return [];
 58:   try {
 59:     const params: Record<string, string | number> = {
 60:       text,
 61:       apiKey,
 62:       limit: 20,
 63:     };
 64:     if (lat && lon) {
 65:       params.bias = `proximity:${lon},${lat}`;
 66:     }
 67:     const response = await axios.get(GEOAPIFY_GEOCODE_URL, { params });
 68:     return response.data.features.map((feature: any, idx: number) => ({
 69:       id: feature.properties.place_id || `search-${idx}`,
 70:       place_id: feature.properties.place_id || `search-${idx}`,
 71:       name: feature.properties.name || feature.properties.formatted || 'Coffee Shop',
 72:       address: feature.properties.formatted || '',
 73:       lat: feature.properties.lat,
 74:       lon: feature.properties.lon,
 75:       distance: 0,
 76:       distance_text: '0 km',
 77:       rating: 4.5,
 78:       total_ratings: 42,
 79:       categories: ['catering.cafe'],
 80:     }));
 81:   } catch (error) {
 82:     console.error('Error searching coffee shops:', error);
 83:     return [];
 84:   }
 85: }
 86: function mapGeoapifyToCoffeeShop(
 87:   feature: any,
 88:   userLat: number,
 89:   userLon: number,
 90:   index: number
 91: ): CoffeeShop {
 92:   const props = feature.properties;
 93:   const dist = props.distance ?? calculateDistanceMeters(userLat, userLon, props.lat, props.lon);
 94:   const distanceKm = (dist / 1000).toFixed(1);
 95:   return {
 96:     id: props.place_id || `shop-${index}`,
 97:     place_id: props.place_id || `shop-${index}`,
 98:     name: props.name || 'Vietnamese Coffee Shop',
 99:     address: props.formatted || props.address_line1 || 'Address unavailable',
100:     lat: props.lat,
101:     lon: props.lon,
102:     distance: dist,
103:     distance_text: `${distanceKm} km`,
104:     rating: props.datasource?.raw?.rating || (4 + (index % 10) * 0.1),
105:     total_ratings: Math.floor(20 + index * 12),
106:     opening_hours: {
107:       open_now: true,
108:     },
109:     price_range: '€€',
110:     categories: props.categories || ['catering.cafe'],
111:     phone: props.datasource?.raw?.phone,
112:     website: props.datasource?.raw?.website,
113:   };
114: }
115: function calculateDistanceMeters(lat1: number, lon1: number, lat2: number, lon2: number): number {
116:   const R = 6371e3;
117:   const dLat = ((lat2 - lat1) * Math.PI) / 180;
118:   const dLon = ((lon2 - lon1) * Math.PI) / 180;
119:   const a =
120:     Math.sin(dLat / 2) * Math.sin(dLat / 2) +
121:     Math.cos((lat1 * Math.PI) / 180) *
122:       Math.cos((lat2 * Math.PI) / 180) *
123:       Math.sin(dLon / 2) *
124:       Math.sin(dLon / 2);
125:   const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
126:   return Math.round(R * c);
127: }
